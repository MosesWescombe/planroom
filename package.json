{
  "name": "@moses-wescombe/planroom",
  "version": "1.2.0",
  "description": "Live browser planning surface for Claude Code: an MCP server that also serves the planning page",
  "type": "module",
  "bin": {
    "planroom": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/ui",
    "!dist/ui/**/*.map",
    "skills",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosesWescombe/planroom.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:cli",
    "build:cli": "vite build --config vite.cli.config.mts",
    "build:server": "tsc -p tsconfig.build.json",
    "build:ui": "vite build",
    "clean": "rm -rf dist",
    "format": "biome check --write .",
    "generate:blocks-doc": "pnpm run build:server && node scripts/generate-blocks-doc.mjs",
    "lint": "biome check .",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fission-ai/openspec": "1.14.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/lodash": "4.17.25",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-sankey": "0.12.3",
    "dagre": "^0.8.5",
    "diff": "9.0.0",
    "express": "^5.2.1",
    "jsdom": "30.1.1",
    "lodash": "4.18.1",
    "lowlight": "3.3.0",
    "mermaid": "12.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "typescript": "^7.0.2",
    "use-sync-external-store": "1.7.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "4.6.5"
  }
}
