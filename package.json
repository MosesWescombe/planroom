{
  "name": "@moses-wescombe/planroom",
  "version": "0.1.0",
  "description": "Live browser planning surface for Claude Code: an MCP server that also serves the planning page",
  "type": "module",
  "bin": {
    "planroom": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/ui",
    "!dist/ui/**/*.map",
    "skill",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosesWescombe/planroom.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:cli",
    "build:cli": "vite build --config vite.cli.config.mts",
    "build:server": "tsc -p tsconfig.build.json",
    "build:ui": "vite build",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "generate:blocks-doc": "pnpm run build:server && node scripts/generate-blocks-doc.mjs",
    "lint": "eslint ./src --ext .ts,.tsx --color",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3-sankey": "^0.12.5",
    "@types/dagre": "^0.7.53",
    "@types/express": "^4.17.1",
    "@types/lodash": "4.14.202",
    "@types/node": "^24.0.0",
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.2.1",
    "d3-sankey": "0.12.3",
    "dagre": "^0.8.5",
    "diff": "9.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "2.25.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "4.3.0",
    "express": "^4.17.3",
    "jsdom": "20.0.3",
    "lodash": "4.18.1",
    "lowlight": "3.3.0",
    "mermaid": "12.0.0",
    "prettier": "^3.8.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-markdown": "8.0.7",
    "typescript": "^6.0.3",
    "use-sync-external-store": "1.6.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.4",
    "zod": "4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "17.0.2",
      "@types/react-dom": "17.0.2"
    }
  }
}
