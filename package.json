{
  "name": "@scopious/planroom",
  "version": "0.1.0",
  "private": true,
  "description": "Live browser planning surface for Claude Code: an MCP server that also serves the planning page",
  "type": "module",
  "main": "dist/server/main.js",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:ui",
    "build:server": "tsc -p tsconfig.build.json",
    "build:ui": "vite build",
    "browse": "node dist/server/main.js --browse",
    "clean": "rimraf ./dist",
    "generate:blocks-doc": "pnpm run build:server && node scripts/generate-blocks-doc.mjs",
    "install:user": "pnpm run build:ui && node scripts/install-user.mjs",
    "lint": "eslint ./src --ext .ts,.tsx --color",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "prettier": "@scopious/prettier-config/web.js",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "d3-sankey": "0.12.3",
    "dagre": "^0.8.5",
    "diff": "9.0.0",
    "express": "^4.17.3",
    "lodash": "4.18.1",
    "lowlight": "3.3.0",
    "mermaid": "12.0.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-markdown": "8.0.7",
    "use-sync-external-store": "1.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@scopious/eslint-config": "workspace:*",
    "@scopious/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3-sankey": "^0.12.5",
    "@types/dagre": "^0.7.53",
    "@types/express": "^4.17.1",
    "@types/lodash": "4.14.202",
    "@types/node": "^24.0.0",
    "@types/react": "17.0.35",
    "@types/react-dom": "17.0.11",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "8.57.1",
    "jsdom": "20.0.3",
    "vite": "^5.2.0",
    "vitest": "^2.1.4"
  }
}
